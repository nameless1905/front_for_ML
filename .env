# Адрес бэкенда, куда dev-сервер Vite проксирует запросы.
# Сервер слушает 0.0.0.0:8000, из браузера к нему обращаемся через localhost.
VITE_BACKEND_URL=http://localhost:8000
# Эндпоинт генерации (можно поменять в интерфейсе)
VITE_PREDICT_PATH=/generate_open_router
# Значение поля "backend" по умолчанию
VITE_DEFAULT_BACKEND=qwen
